ELEPH_DEVICE_ID=bathroom-monitor-001
ELEPH_SENSOR_MODE=c4001-i2c
ELEPH_GPIO_PIN=
ELEPH_SENSOR_ACTIVE_LOW=true
ELEPH_DEBOUNCE_MS=200
ELEPH_COOLDOWN_SECONDS=2
ELEPH_POLL_INTERVAL_SECONDS=1.0
ELEPH_EVENT_QUEUE_SIZE=100
ELEPH_LOG_LEVEL=INFO
ELEPH_C4001_I2C_BUS=1
ELEPH_C4001_I2C_ADDRESS=0x2A
ELEPH_C4001_MIN_RANGE_CM=30
ELEPH_C4001_MAX_RANGE_CM=300
ELEPH_C4001_TRIGGER_RANGE_CM=300
ELEPH_C4001_TRIGGER_SENSITIVITY=1
ELEPH_C4001_KEEP_SENSITIVITY=2
ELEPH_C4001_TRIGGER_DELAY_MS=100
ELEPH_C4001_KEEP_TIMEOUT_SECONDS=2
ELEPH_C4001_CONFIGURE_ON_START=true
SUPABASE_URL=
SUPABASE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_MOTION_TABLE=motion_events
